# cPanel environment settings, not browser secrets. Never upload a real .env.
NODE_ENV=production
ORIGIN=https://automesh.online
HOST=127.0.0.1
# Passenger normally assigns PORT. Do not override its assigned port.
# PORT=8080
SIGNALING_MAX_CONNECTIONS=256
# Optional browser origins permitted to use THIS signaling service (comma-separated).
# Empty means only ORIGIN. This permission never adds client connection defaults.
# SIGNALING_ALLOWED_ORIGINS=https://another-app.example
# Default public signaling is the same origin: wss://automesh.online/signal.
# Optional STUN configuration; an empty value disables external STUN entirely.
# MESH_RUNTIME_STUN_URLS=stun:stun.example.org:3478
# MESH_RUNTIME_STUN_URLS=
