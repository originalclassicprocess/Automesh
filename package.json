{
  "name": "mesh-autonomy",
  "private": true,
  "version": "0.5.6",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "start": "node server/app.js",
    "release": "npm run build && node scripts/prepare-release.mjs",
    "signaling": "node server/signaling.js",
    "node:build:windows": "node scripts/build-home-node.mjs",
    "node:build:linux": "node scripts/build-linux-node.mjs",
    "lan": "node scripts/lan.mjs",
    "lan:pwa": "node scripts/lan.mjs --pwa",
    "lan:pwa:web": "node scripts/lan.mjs --pwa --app-only",
    "lan:signal": "node scripts/lan.mjs --signal-only",
    "build": "vite build",
    "local:pwa": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run src server && npm run test:nodes",
    "test:nodes": "npm --prefix nodes test",
    "node:export": "node scripts/export-node-project.mjs",
    "test:pwa": "npm run build && node scripts/test-pwa-shell.mjs",
    "test:production": "node scripts/test-production.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:core": "tsc --project tsconfig.core.json",
    "i18n:check": "node scripts/check-translations.mjs",
    "licenses:inventory": "node scripts/license-inventory.mjs",
    "test:core": "vitest run src/lib/core src/lib/core-storage src/lib/identity src/lib/addressing src/lib/message src/lib/chat/secure-session.test.ts src/lib/chat/ChatService.test.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@hpke/core": "1.9.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "@zxcvbn-ts/language-ru": "4.1.0",
    "fake-indexeddb": "6.2.5",
    "fflate": "0.8.3",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "cookie": "^0.7.2"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/originalclassicprocess/Automesh.git"
  },
  "bugs": {
    "url": "https://github.com/originalclassicprocess/Automesh/issues"
  },
  "homepage": "https://github.com/originalclassicprocess/Automesh#readme"
}
